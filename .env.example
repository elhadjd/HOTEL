DATABASE_URL="mysql://hotelaria:hotelaria@127.0.0.1:3306/sigesc_hotelaria"
AUTH_SECRET="dev-auth-secret-change-me-min-32-chars!!"
# Public site URL (required in production behind proxy / PM2)
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AGGREGATE_ENCRYPTION_KEY="dev-aggregate-encryption-key-32chars-min"
SIGESC_AGGREGATE_MODE="mock"
SIGESC_AGGREGATE_HOST="https://app.sisgesc.net"
# Optional comma-separated override (defaults: app/admin.sisgesc.net, app/admin.zyvoerp.com)
# SIGESC_AGGREGATE_ALLOWED_HOSTS="admin.sisgesc.net,app.sisgesc.net"
SIGESC_REGISTER_URL="https://app.sisgesc.net"
NODE_ENV="development"

# Email — mock (default) or smtp
EMAIL_MODE="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@hotelaria.local"
SMTP_FROM_NAME="SIGESC Hotelaria"

# Auth lifecycle TTLs
TEMP_PASSWORD_TTL_HOURS="24"
PASSWORD_RESET_TTL_MINUTES="30"
ONBOARDING_CHALLENGE_TTL_MINUTES="15"
