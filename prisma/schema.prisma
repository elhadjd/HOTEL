generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS_DENIED
}

enum AggregateConnectionStatus {
  ACTIVE
  ERROR
  REVOKED
  DISCONNECTED
}

enum AggregateSyncKind {
  ONBOARDING
  USERS
  COMPANIES
  KEY_ROTATION
  CUSTOMERS
  PRODUCTS
  SALES
}

enum InvoiceIntegrationStatus {
  DRAFT
  PENDING_SUBMISSION
  SUBMITTING
  CREATED
  RECONCILIATION_REQUIRED
  FAILED_VALIDATION
  FAILED_FINAL
}

enum CatalogKind {
  PRODUCT
  SERVICE
}

enum AggregateSyncOutcome {
  SUCCESS
  FAILED
  PARTIAL
  SKIPPED
}

enum OccupancyStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  INSPECTING
}

enum MaintenanceStatus {
  OK
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  DRAFT
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum StayStatus {
  ACTIVE
  CHECKOUT_PENDING
  COMPLETED
  CANCELLED
}

enum HousekeepingTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  INSPECTION_REQUIRED
  REJECTED
  CANCELLED
}

enum HousekeepingTaskKind {
  CLEANING
  INSPECTION
  PREPARATION
  LINEN_CHANGE
  MAINTENANCE_CLEAN
  TURNOVER
}

enum HousekeepingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CANCELLED
}

enum StayChargeKind {
  ACCOMMODATION
  EXTRA_SERVICE
  PRODUCT
  FEE
  DISCOUNT
  ADJUSTMENT
}

enum StayChargeStatus {
  PENDING
  CONFIRMED
  VOIDED
  HANDED_OFF
}

enum FinancialHandoffStatus {
  NOT_REQUIRED
  PENDING
  REQUESTED
  CENTRAL_CONFIRMED
  RECONCILIATION_PENDING
  FAILED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CustomerSyncStatus {
  /** @deprecated Phase 5 — legacy only; new guests must be LINKED */
  UNLINKED
  /** Historical guests awaiting explicit customer association (Phase 5) */
  NEEDS_RESOLUTION
  PENDING
  LINKED
  CONFLICT
  ERROR
}

enum NotificationKind {
  INFO
  ALERT
  TASK
  SYSTEM
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DEAD
}

enum EmailTemplateKind {
  ONBOARDING_TEMP_PASSWORD
  PASSWORD_RECOVERY
  PASSWORD_CHANGED
  USER_INVITATION
}

// ─── Tenant & IAM ────────────────────────────────────────────────────────────

model Institution {
  id               String   @id @default(uuid())
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(120)
  nif              String?  @db.VarChar(64)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(64)
  city             String?  @db.VarChar(120)
  country          String?  @db.VarChar(120)
  street           String?  @db.VarChar(255)
  addressNumber    String?  @map("address_number") @db.VarChar(32)
  zipCode          String?  @map("zip_code") @db.VarChar(32)
  timezone         String   @default("Africa/Luanda") @db.VarChar(64)
  currency         String   @default("AOA") @db.Char(3)
  locale           String   @default("pt") @db.VarChar(8)
  sigescCompanyRef String?  @map("sigesc_company_ref") @db.VarChar(128)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  roles               Role[]
  hotels              Hotel[]
  guests              Guest[]
  auditLogs           AuditLog[]
  syncMappings        SyncMapping[]
  aggregateConnection AggregateConnection?
  aggregateSyncRuns   AggregateSyncRun[]
  notifications       Notification[]
  emailOutbox          EmailOutbox[]
  onboardingChallenges OnboardingChallenge[]
  productCatalogMaps   ProductCatalogMapping[]
  invoiceIntegrations  InvoiceIntegration[]

  @@map("institutions")
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique @db.VarChar(255)
  passwordHash              String    @map("password_hash") @db.VarChar(255)
  name                      String    @db.VarChar(255)
  externalId                String?   @map("external_id") @db.VarChar(128)
  invitePending             Boolean   @default(false) @map("invite_pending")
  /** Official Aggregate admin for the institution — only this user gets hotel_admin at onboarding */
  isInstitutionAdmin        Boolean   @default(false) @map("is_institution_admin")
  mustChangePassword        Boolean   @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime? @map("temporary_password_expires_at")
  passwordChangedAt         DateTime? @map("password_changed_at")
  /** Bumped to invalidate JWT sessions */
  sessionVersion            Int       @default(0) @map("session_version")
  active                    Boolean   @default(true)
  lastLoginAt               DateTime? @map("last_login_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  memberships         Membership[]
  sessions            Session[]
  accounts            Account[]
  auditLogs           AuditLog[] @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
  emailOutbox         EmailOutbox[]

  @@index([externalId])
  @@map("users")
}

/** Server-side two-step onboarding challenge — encrypted key never returned to browser. */
model OnboardingChallenge {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique @map("token_hash") @db.VarChar(128)
  encryptedApiKey      String    @map("encrypted_api_key") @db.Text
  keyPrefix            String    @map("key_prefix") @db.VarChar(32)
  ownerCompanyExternalId String  @map("owner_company_external_id") @db.VarChar(64)
  companySnapshot      Json      @map("company_snapshot")
  adminSnapshot        Json      @map("admin_snapshot")
  usersSnapshot        Json      @map("users_snapshot")
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  institutionId        String?   @map("institution_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("onboarding_challenges")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  requestIp  String?   @map("request_ip") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailOutbox {
  id            String            @id @default(uuid())
  institutionId String?           @map("institution_id")
  userId        String?           @map("user_id")
  template      EmailTemplateKind
  toEmail       String            @map("to_email") @db.VarChar(255)
  subject       String            @db.VarChar(255)
  /** Never store plaintext passwords/tokens — only non-secret template vars */
  payloadJson   Json              @map("payload_json")
  /** Encrypted one-time secret for templates that need it (temp password / reset URL token) */
  encryptedSecret String?         @map("encrypted_secret") @db.Text
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at")
  sentAt        DateTime?         @map("sent_at")
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([institutionId])
  @@map("email_outbox")
}

model AuthRateLimit {
  id          String   @id @default(uuid())
  bucketKey   String   @unique @map("bucket_key") @db.VarChar(191)
  hitCount    Int      @default(0) @map("hit_count")
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("auth_rate_limits")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  code          String   @db.VarChar(64)
  name          String   @db.VarChar(120)
  description   String?  @db.VarChar(255)
  system        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(120)
  module      String  @db.VarChar(64)
  action      String  @db.VarChar(64)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id                      String           @id @default(uuid())
  institutionId           String           @map("institution_id")
  userId                  String           @map("user_id")
  roleId                  String           @map("role_id")
  status                  MembershipStatus @default(ACTIVE)
  aggregateSuggestedLevel String?          @map("aggregate_suggested_level") @db.VarChar(32)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([institutionId, userId])
  @@index([userId])
  @@index([institutionId, status])
  @@map("memberships")
}

// ─── Hotels & rooms ──────────────────────────────────────────────────────────

model Hotel {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(255)
  code          String   @db.VarChar(64)
  description   String?  @db.Text
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(64)
  street        String?  @db.VarChar(255)
  city          String?  @db.VarChar(120)
  country       String?  @db.VarChar(120)
  zipCode       String?  @map("zip_code") @db.VarChar(32)
  facilities    Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  settings          HotelSettings?
  roomCategories    RoomCategory[]
  rooms             Room[]
  reservations      Reservation[]
  stays             Stay[]
  housekeepingTasks HousekeepingTask[]
  maintenanceReqs   MaintenanceRequest[]
  ratePlans         RatePlan[]

  @@unique([institutionId, code])
  @@index([institutionId, active])
  @@map("hotels")
}

model HotelSettings {
  id               String   @id @default(uuid())
  hotelId          String   @unique @map("hotel_id")
  checkInTime      String   @default("14:00") @map("check_in_time") @db.VarChar(8)
  checkOutTime     String   @default("12:00") @map("check_out_time") @db.VarChar(8)
  timezone         String   @default("Africa/Luanda") @db.VarChar(64)
  currency         String   @default("AOA") @db.Char(3)
  locale           String   @default("pt") @db.VarChar(8)
  maxStayNights    Int?     @map("max_stay_nights")
  allowChildren    Boolean  @default(true) @map("allow_children")
  policiesJson     Json?    @map("policies_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_settings")
}

model RoomCategory {
  id               String   @id @default(uuid())
  hotelId          String   @map("hotel_id")
  name             String   @db.VarChar(120)
  code             String   @db.VarChar(64)
  description      String?  @db.Text
  maxOccupancy     Int      @default(2) @map("max_occupancy")
  maxAdults        Int      @default(2) @map("max_adults")
  maxChildren      Int      @default(0) @map("max_children")
  bedConfiguration String?  @map("bed_configuration") @db.VarChar(255)
  amenitiesJson    Json?    @map("amenities_json")
  defaultTariff    Decimal? @map("default_tariff") @db.Decimal(14, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms     Room[]
  ratePlans RatePlan[]

  @@unique([hotelId, code])
  @@index([hotelId, active])
  @@map("room_categories")
}

model Room {
  id                 String             @id @default(uuid())
  hotelId            String             @map("hotel_id")
  categoryId         String             @map("category_id")
  code               String             @db.VarChar(64)
  floor              String?            @db.VarChar(32)
  capacity           Int                @default(2)
  description        String?            @db.Text
  amenitiesJson      Json?              @map("amenities_json")
  occupancyStatus    OccupancyStatus    @default(AVAILABLE) @map("occupancy_status")
  housekeepingStatus HousekeepingStatus @default(CLEAN) @map("housekeeping_status")
  maintenanceStatus  MaintenanceStatus  @default(OK) @map("maintenance_status")
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category            RoomCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              RoomImage[]
  reservationRooms    ReservationRoom[]
  stays               Stay[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([hotelId, code])
  @@index([hotelId, occupancyStatus])
  @@index([hotelId, housekeepingStatus])
  @@index([hotelId, maintenanceStatus])
  @@map("rooms")
}

model RoomImage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  storageKey String  @map("storage_key") @db.VarChar(512)
  alt       String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_images")
}

// ─── Guests ──────────────────────────────────────────────────────────────────

model Guest {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  firstName     String   @map("first_name") @db.VarChar(120)
  lastName      String   @map("last_name") @db.VarChar(120)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(40)
  country       String?  @db.VarChar(120)
  preferencesJson Json?  @map("preferences_json")
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution      Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  documents        GuestDocument[]
  customerMapping  GuestCustomerMapping?
  reservationGuests ReservationGuest[]
  stays             Stay[]
  stayCompanions    StayCompanion[]

  @@index([institutionId, lastName, firstName])
  @@index([institutionId, email])
  @@map("guests")
}

model GuestDocument {
  id         String    @id @default(uuid())
  guestId    String    @map("guest_id")
  type       String    @db.VarChar(64)
  reference  String    @db.VarChar(128)
  issuedAt   DateTime? @map("issued_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@map("guest_documents")
}

model GuestCustomerMapping {
  id                 String             @id @default(uuid())
  guestId            String             @unique @map("guest_id")
  institutionId      String             @map("institution_id")
  connectionId       String?            @map("connection_id")
  externalCustomerId String?            @map("external_customer_id") @db.VarChar(128)
  companyId          String?            @map("company_id") @db.VarChar(64)
  syncStatus         CustomerSyncStatus @default(UNLINKED) @map("sync_status")
  lastSyncedAt       DateTime?          @map("last_synced_at")
  lastError          String?            @map("last_error") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([institutionId, externalCustomerId])
  @@index([institutionId, syncStatus])
  @@index([externalCustomerId])
  @@map("guest_customer_mappings")
}

/**
 * Local operational service/catalog entry mapped to a central SIGESC product.
 * Official sale price and tax come ONLY from SIGESC Central (refreshed on use).
 * legacyHistoricalPrice is non-authoritative audit residue from Phase 4 — never use for invoicing.
 */
model ProductCatalogMapping {
  id                      String      @id @default(uuid())
  institutionId           String      @map("institution_id")
  connectionId            String?     @map("connection_id")
  localCode               String      @map("local_code") @db.VarChar(64)
  localLabel              String      @map("local_label") @db.VarChar(255)
  /** Non-authoritative Phase 4 residue — never use as official price */
  legacyHistoricalPrice   Decimal?    @map("legacy_historical_price") @db.Decimal(14, 2)
  kind                    CatalogKind @default(SERVICE)
  centralProductId        String      @map("central_product_id") @db.VarChar(64)
  centralCompanyId        String      @map("central_company_id") @db.VarChar(64)
  centralName             String?     @map("central_name") @db.VarChar(255)
  /** Last verified cache of central sale_price — not editable; refresh from Aggregate */
  centralSalePrice        Decimal?    @map("central_sale_price") @db.Decimal(14, 2)
  centralTaxPercent       Decimal?    @map("central_tax_percent") @db.Decimal(8, 4)
  centralPriceVerifiedAt  DateTime?   @map("central_price_verified_at")
  active                  Boolean     @default(true)
  lastSyncedAt            DateTime?   @map("last_synced_at")
  lastError               String?     @map("last_error") @db.Text
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, localCode])
  @@index([institutionId, centralProductId])
  @@index([institutionId, active])
  @@map("product_catalog_mappings")
}

/**
 * Local record of a Cotação/Proforma submission to Aggregate.
 * externalId is the idempotency key — never regenerate after ambiguous timeout.
 */
model InvoiceIntegration {
  id                   String                   @id @default(uuid())
  institutionId        String                   @map("institution_id")
  connectionId         String                   @map("connection_id")
  reservationId        String?                  @map("reservation_id")
  stayId               String?                  @map("stay_id")
  guestId              String?                  @map("guest_id")
  hotelId              String?                  @map("hotel_id")
  externalId           String                   @map("external_id") @db.VarChar(128)
  partner              String                   @default("sigesc_hotelaria") @db.VarChar(64)
  requestedState       String                   @map("requested_state") @db.VarChar(32)
  status               InvoiceIntegrationStatus @default(DRAFT)
  centralCompanyId     String                   @map("central_company_id") @db.VarChar(64)
  centralCustomerId    String?                  @map("central_customer_id") @db.VarChar(64)
  centralSaleId        String?                  @map("central_sale_id") @db.VarChar(64)
  saleKey              String?                  @map("sale_key") @db.VarChar(64)
  orderReference       String?                  @map("order_reference") @db.VarChar(128)
  centralState         String?                  @map("central_state") @db.VarChar(32)
  centralTotal         Decimal?                 @map("central_total") @db.Decimal(14, 2)
  centralSubtotal      Decimal?                 @map("central_subtotal") @db.Decimal(14, 2)
  centralTax           Decimal?                 @map("central_tax") @db.Decimal(14, 2)
  centralRestPayable   Decimal?                 @map("central_rest_payable") @db.Decimal(14, 2)
  currency             String                   @default("AOA") @db.Char(3)
  notes                String?                  @db.Text
  /** Non-secret line snapshot for audit (product ids, qty, prices, discounts) */
  linesJson            Json                     @map("lines_json")
  idempotentHit        Boolean                  @default(false) @map("idempotent_hit")
  lastError            String?                  @map("last_error") @db.Text
  createdByUserId      String?                  @map("created_by_user_id")
  submittedAt          DateTime?                @map("submitted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  institution Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  attempts    InvoiceSubmissionAttempt[]

  @@unique([institutionId, externalId])
  @@index([institutionId, status])
  @@index([saleKey])
  @@index([reservationId])
  @@index([stayId])
  @@index([guestId])
  @@index([hotelId])
  @@index([institutionId, createdAt])
  @@map("invoice_integrations")
}

model InvoiceSubmissionAttempt {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  attemptNo       Int      @map("attempt_no")
  outcome         String   @db.VarChar(64)
  httpStatus      Int?     @map("http_status")
  remoteSaleKey   String?  @map("remote_sale_key") @db.VarChar(64)
  /** Sanitized remote summary — never credentials */
  responseSummary Json?    @map("response_summary")
  errorMessage    String?  @map("error_message") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  invoice InvoiceIntegration @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, attemptNo])
  @@index([invoiceId, createdAt])
  @@map("invoice_submission_attempts")
}

// ─── Reservations & stays ────────────────────────────────────────────────────

model Reservation {
  id              String            @id @default(uuid())
  hotelId         String            @map("hotel_id")
  institutionId   String            @map("institution_id")
  code            String            @db.VarChar(64)
  status          ReservationStatus @default(DRAFT)
  arrivalDate     DateTime          @map("arrival_date") @db.Date
  departureDate   DateTime          @map("departure_date") @db.Date
  adults          Int               @default(1)
  children        Int               @default(0)
  source          String?           @db.VarChar(64)
  internalNotes   String?           @map("internal_notes") @db.Text
  operationalTotal Decimal?         @map("operational_total") @db.Decimal(14, 2)
  currency        String            @default("AOA") @db.Char(3)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  hotel   Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms   ReservationRoom[]
  guests  ReservationGuest[]
  stay    Stay?
  events  ReservationEvent[]
  checkIns  CheckInRecord[]
  checkOuts CheckOutRecord[]

  @@unique([hotelId, code])
  @@index([institutionId, status])
  @@index([hotelId, arrivalDate, departureDate])
  @@map("reservations")
}

model ReservationRoom {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  roomId        String   @map("room_id")
  arrivalDate   DateTime @map("arrival_date") @db.Date
  departureDate DateTime @map("departure_date") @db.Date
  nightlyRate   Decimal? @map("nightly_rate") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([reservationId, roomId])
  @@index([roomId, arrivalDate, departureDate])
  @@map("reservation_rooms")
}

model ReservationGuest {
  id            String  @id @default(uuid())
  reservationId String  @map("reservation_id")
  guestId       String  @map("guest_id")
  isPrimary     Boolean @default(false) @map("is_primary")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([reservationId, guestId])
  @@map("reservation_guests")
}

model ReservationEvent {
  id            String             @id @default(uuid())
  reservationId String             @map("reservation_id")
  fromStatus    ReservationStatus? @map("from_status")
  toStatus      ReservationStatus  @map("to_status")
  note          String?            @db.VarChar(500)
  actorUserId   String?            @map("actor_user_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("reservation_events")
}

model Stay {
  id                String     @id @default(uuid())
  hotelId           String     @map("hotel_id")
  institutionId     String     @map("institution_id")
  reservationId     String     @unique @map("reservation_id")
  roomId            String     @map("room_id")
  guestId           String     @map("guest_id")
  status            StayStatus @default(ACTIVE)
  actualArrival     DateTime   @map("actual_arrival")
  expectedDeparture DateTime   @map("expected_departure") @db.Date
  actualDeparture   DateTime?  @map("actual_departure")
  originalDeparture DateTime?  @map("original_departure") @db.Date
  observations      String?    @db.Text
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  hotel        Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation  Reservation         @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  room         Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guest        Guest               @relation(fields: [guestId], references: [id], onDelete: Restrict)
  checkIn      CheckInRecord?
  checkOut     CheckOutRecord?
  companions   StayCompanion[]
  roomHistory  StayRoomHistory[]
  dateChanges  StayDateChange[]
  accountLines StayAccountCharge[]

  @@index([hotelId, status])
  @@index([institutionId, status])
  @@index([roomId, status])
  @@index([institutionId, expectedDeparture])
  @@map("stays")
}

model StayCompanion {
  id        String    @id @default(uuid())
  stayId    String    @map("stay_id")
  guestId   String    @map("guest_id")
  addedAt   DateTime  @default(now()) @map("added_at")
  removedAt DateTime? @map("removed_at")
  notes     String?   @db.VarChar(500)

  stay  Stay  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([stayId, guestId])
  @@index([stayId, removedAt])
  @@map("stay_companions")
}

model StayRoomHistory {
  id           String   @id @default(uuid())
  stayId       String   @map("stay_id")
  fromRoomId   String   @map("from_room_id")
  toRoomId     String   @map("to_room_id")
  reason       String   @db.VarChar(500)
  actorUserId  String?  @map("actor_user_id")
  transferredAt DateTime @default(now()) @map("transferred_at")

  stay Stay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId, transferredAt])
  @@map("stay_room_history")
}

model StayDateChange {
  id              String   @id @default(uuid())
  stayId          String   @map("stay_id")
  kind            String   @db.VarChar(32)
  previousDeparture DateTime @map("previous_departure") @db.Date
  newDeparture    DateTime @map("new_departure") @db.Date
  reason          String?  @db.VarChar(500)
  actorUserId     String?  @map("actor_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  stay Stay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId, createdAt])
  @@map("stay_date_changes")
}

model StayAccountCharge {
  id                 String           @id @default(uuid())
  stayId             String           @map("stay_id")
  institutionId      String           @map("institution_id")
  kind               StayChargeKind   @default(EXTRA_SERVICE)
  status             StayChargeStatus @default(PENDING)
  description        String           @db.VarChar(255)
  quantity           Decimal          @default(1) @db.Decimal(12, 3)
  /** Verified central unit price — never browser-authored for mapped products */
  unitPrice          Decimal          @map("unit_price") @db.Decimal(14, 2)
  currency           String           @default("AOA") @db.Char(3)
  catalogMappingId   String?          @map("catalog_mapping_id")
  centralProductId   String?          @map("central_product_id") @db.VarChar(64)
  invoiceIntegrationId String?        @map("invoice_integration_id")
  actorUserId        String?          @map("actor_user_id")
  voidReason         String?          @map("void_reason") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  stay Stay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId, status])
  @@index([institutionId, createdAt])
  @@map("stay_account_charges")
}

model CheckInRecord {
  id            String   @id @default(uuid())
  stayId        String   @unique @map("stay_id")
  reservationId String   @map("reservation_id")
  checkedInAt   DateTime @default(now()) @map("checked_in_at")
  actorUserId   String?  @map("actor_user_id")
  notes         String?  @db.Text
  occupantCount Int      @default(1) @map("occupant_count")

  stay        Stay        @relation(fields: [stayId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("check_in_records")
}

model CheckOutRecord {
  id                     String                  @id @default(uuid())
  stayId                 String                  @unique @map("stay_id")
  reservationId          String                  @map("reservation_id")
  checkedOutAt           DateTime                @default(now()) @map("checked_out_at")
  actorUserId            String?                 @map("actor_user_id")
  notes                  String?                 @db.Text
  financialHandoffStatus FinancialHandoffStatus  @default(PENDING) @map("financial_handoff_status")
  financialExternalRef   String?                 @map("financial_external_ref") @db.VarChar(128)
  financialConfirmedAt   DateTime?               @map("financial_confirmed_at")
  invoiceIntegrationId   String?                 @map("invoice_integration_id")
  operationalComplete    Boolean                 @default(true) @map("operational_complete")

  stay        Stay        @relation(fields: [stayId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("check_out_records")
}

// ─── Housekeeping & maintenance ──────────────────────────────────────────────

model HousekeepingTask {
  id               String                 @id @default(uuid())
  hotelId          String                 @map("hotel_id")
  roomId           String                 @map("room_id")
  stayId           String?                @map("stay_id")
  kind             HousekeepingTaskKind   @default(CLEANING)
  status           HousekeepingTaskStatus @default(PENDING)
  priority         HousekeepingPriority   @default(NORMAL)
  assignedTo       String?                @map("assigned_to") @db.VarChar(128)
  notes            String?                @db.Text
  deadlineAt       DateTime?              @map("deadline_at")
  startedAt        DateTime?              @map("started_at")
  completedAt      DateTime?              @map("completed_at")
  inspectedAt      DateTime?              @map("inspected_at")
  inspectionResult String?                @map("inspection_result") @db.VarChar(32)
  inspectionNotes  String?                @map("inspection_notes") @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([hotelId, status, priority])
  @@index([roomId, status])
  @@index([hotelId, kind, status])
  @@map("housekeeping_tasks")
}

model MaintenanceRequest {
  id                 String                   @id @default(uuid())
  hotelId            String                   @map("hotel_id")
  roomId             String?                  @map("room_id")
  title              String                   @db.VarChar(255)
  description        String?                  @db.Text
  category           String?                  @db.VarChar(64)
  status             MaintenanceRequestStatus @default(OPEN)
  priority           MaintenancePriority      @default(NORMAL)
  assignedTo         String?                  @map("assigned_to") @db.VarChar(128)
  blocksRoom         Boolean                  @default(false) @map("blocks_room")
  resolution         String?                  @db.Text
  materialsNotes     String?                  @map("materials_notes") @db.Text
  materialsCost      Decimal?                 @map("materials_cost") @db.Decimal(14, 2)
  interventionNotes  String?                  @map("intervention_notes") @db.Text
  scheduledAt        DateTime?                @map("scheduled_at")
  startedAt          DateTime?                @map("started_at")
  resolvedAt         DateTime?                @map("resolved_at")
  reopenedAt         DateTime?                @map("reopened_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([hotelId, status, priority])
  @@index([roomId, status])
  @@map("maintenance_requests")
}

// ─── Rates ───────────────────────────────────────────────────────────────────

model RatePlan {
  id                 String    @id @default(uuid())
  hotelId            String    @map("hotel_id")
  categoryId         String    @map("category_id")
  name               String    @db.VarChar(120)
  code               String    @db.VarChar(64)
  description        String?   @db.Text
  baseAmount         Decimal   @map("base_amount") @db.Decimal(14, 2)
  currency           String    @default("AOA") @db.Char(3)
  weekdayOnly        Boolean   @default(false) @map("weekday_only")
  weekendOnly        Boolean   @default(false) @map("weekend_only")
  validFrom          DateTime? @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  minStayNights      Int       @default(1) @map("min_stay_nights")
  maxStayNights      Int?      @map("max_stay_nights")
  includedOccupancy  Int       @default(2) @map("included_occupancy")
  extraGuestAmount   Decimal?  @map("extra_guest_amount") @db.Decimal(14, 2)
  /** Higher priority wins when multiple plans match a night */
  priority           Int       @default(0)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  hotel      Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category   RoomCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seasonals  SeasonalRate[]
  audits     RatePlanAudit[]

  @@unique([hotelId, code])
  @@index([hotelId, categoryId, active])
  @@index([hotelId, validFrom, validTo])
  @@map("rate_plans")
}

model SeasonalRate {
  id           String   @id @default(uuid())
  ratePlanId   String   @map("rate_plan_id")
  name         String   @db.VarChar(120)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  amount       Decimal  @db.Decimal(14, 2)
  minOccupancy Int?     @map("min_occupancy")
  weekendOnly  Boolean  @default(false) @map("weekend_only")
  weekdayOnly  Boolean  @default(false) @map("weekday_only")
  createdAt    DateTime @default(now()) @map("created_at")

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId, startDate, endDate])
  @@map("seasonal_rates")
}

model RatePlanAudit {
  id          String   @id @default(uuid())
  ratePlanId  String   @map("rate_plan_id")
  actorUserId String?  @map("actor_user_id")
  action      String   @db.VarChar(64)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @default(now()) @map("created_at")

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId, createdAt])
  @@map("rate_plan_audits")
}

// ─── SIGESC Aggregate ────────────────────────────────────────────────────────

model AggregateConnection {
  id                       String                    @id @default(uuid())
  institutionId            String                    @unique @map("institution_id")
  host                     String                    @db.VarChar(255)
  encryptedApiKey          String                    @map("encrypted_api_key") @db.Text
  keyPrefix                String                    @map("key_prefix") @db.VarChar(32)
  keyName                  String?                   @map("key_name") @db.VarChar(120)
  scopesJson               Json?                     @map("scopes_json")
  status                   AggregateConnectionStatus @default(ACTIVE)
  ownerCompanyExternalId   String?                   @map("owner_company_external_id") @db.VarChar(64)
  lastOnboardingAt         DateTime?                 @map("last_onboarding_at")
  lastUsersSyncAt          DateTime?                 @map("last_users_sync_at")
  lastCustomersSyncAt      DateTime?                 @map("last_customers_sync_at")
  lastCustomersSyncOutcome AggregateSyncOutcome?     @map("last_customers_sync_outcome")
  lastError                String?                   @map("last_error") @db.Text
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  syncRuns    AggregateSyncRun[]

  @@map("aggregate_connections")
}

model AggregateSyncRun {
  id                String            @id @default(uuid())
  institutionId     String            @map("institution_id")
  connectionId      String?           @map("connection_id")
  kind              AggregateSyncKind
  success           Boolean           @default(false)
  companiesUpserted Int               @default(0) @map("companies_upserted")
  usersUpserted     Int               @default(0) @map("users_upserted")
  pagesProcessed    Int               @default(0) @map("pages_processed")
  errorMessage      String?           @map("error_message") @db.Text
  detailsJson       Json?             @map("details_json")
  createdAt         DateTime          @default(now()) @map("created_at")

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  connection  AggregateConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@map("aggregate_sync_runs")
}

model SyncMapping {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  localType     String   @map("local_type") @db.VarChar(64)
  localId       String   @map("local_id") @db.VarChar(64)
  remoteSystem  String   @map("remote_system") @db.VarChar(64)
  remoteId      String   @map("remote_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, localType, localId, remoteSystem])
  @@unique([institutionId, remoteSystem, localType, remoteId], map: "sync_mappings_inst_remote_uniq")
  @@index([remoteSystem, remoteId])
  @@map("sync_mappings")
}

model AuditLog {
  id            String      @id @default(uuid())
  institutionId String?     @map("institution_id")
  actorUserId   String?     @map("actor_user_id")
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(64)
  entityId      String?     @map("entity_id") @db.VarChar(64)
  metadata      Json?
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id            String           @id @default(uuid())
  institutionId String           @map("institution_id")
  userId        String?          @map("user_id")
  kind          NotificationKind @default(INFO)
  title         String           @db.VarChar(255)
  body          String?          @db.Text
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, userId, readAt])
  @@map("notifications")
}
